rules_version = '2';

// ServiceFlow Firestore rules — Stage 2 (foundation).
//
// Principles (SERVICEFLOW_MIGRATION_PLAN.md §10):
//  1. Deny by default — every collection opts in explicitly.
//  2. Clients never write status, money, stats, verification, claims, commission
//     or audit data; those are written only by Cloud Functions (Admin SDK
//     bypasses these rules).
//  3. Roles come ONLY from verified custom claims (request.auth.token), which
//     only Cloud Functions can set.
//
// Stage 2 opens exactly three read paths: the public service catalogue, the
// public service-area catalogue, and platform settings for signed-in users.
// Every other collection stays closed until the stage that introduces it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // ── Public catalogue ───────────────────────────────────────────────
    // Anyone (even signed out) may read ACTIVE services; admins see all.
    // List queries must filter on isActive == true to be allowed.
    // Writes go through an audited admin callable, never the client.
    match /services/{serviceId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if false;
    }

    match /serviceAreas/{areaId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if false;
    }

    // ── Settings ───────────────────────────────────────────────────────
    // Non-sensitive platform configuration (currency, time zone, limits).
    // Secrets never live in Firestore.
    match /settings/{docId} {
      allow read: if signedIn() && docId in ["platform", "flags"];
      allow write: if false;
    }

    // ── Everything else: closed ────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
