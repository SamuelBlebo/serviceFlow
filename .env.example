# LEGACY Express API (apps/backend) only — frozen and removed domain by domain.
# New apps have their own examples: apps/web/.env.example, apps/mobile/.env.example,
# apps/functions/.env.example.

# --- Database ---
DATABASE_URL="postgresql://serviceflow:serviceflow@localhost:5432/serviceflow?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
ADMIN_BOOTSTRAP_EMAIL="admin@serviceflow.dev"
ADMIN_BOOTSTRAP_PASSWORD="change-me"

# --- OTP ---
OTP_PROVIDER="mock"          # mock | future SMS provider
OTP_TTL_SECONDS="300"
OTP_LENGTH="6"

# --- WhatsApp ---
WHATSAPP_PROVIDER="mock"     # mock | meta_cloud_api
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-me-verify-token"
WHATSAPP_APP_SECRET=""       # used to verify X-Hub-Signature-256 on webhooks

# --- Payments ---
PAYMENT_PROVIDER="mock"      # mock | paystack | flutterwave | hubtel
PAYMENT_PROVIDER_SECRET_KEY=""
PAYMENT_PROVIDER_PUBLIC_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- App ---
PORT="4000"
NODE_ENV="development"
DEFAULT_COMMISSION_PERCENT="15"
DEFAULT_CURRENCY="GHS"
DEFAULT_COUNTRY="GH"
DEFAULT_CITY="Accra"
