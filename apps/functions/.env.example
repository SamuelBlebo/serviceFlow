# ServiceFlow Cloud Functions — NON-SECRET parameters (firebase-functions params).
# Copy to apps/functions/.env (or .env.<projectId>); `pnpm --filter @serviceflow/functions build`
# copies it into dist/, where Firebase reads it. Defaults are used when unset.
#
# SECRETS are never put in .env files. Set them in Secret Manager:
#   firebase functions:secrets:set PAYMENT_SECRET_KEY
#   firebase functions:secrets:set PAYMENT_WEBHOOK_SECRET
#   firebase functions:secrets:set WHATSAPP_ACCESS_TOKEN
#   firebase functions:secrets:set WHATSAPP_APP_SECRET
# (The emulator reads local secret values from apps/functions/dist/.secret.local — never commit it.)

# Deploy region — placeholder until Decision D3.
FUNCTIONS_REGION=europe-west1

# Provider selection (only "mock" exists until the Payments / WhatsApp / Auth stages).
PAYMENT_PROVIDER=mock
WHATSAPP_PROVIDER=mock
OTP_PROVIDER=mock
