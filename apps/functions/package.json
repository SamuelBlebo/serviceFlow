{
  "name": "@serviceflow/functions",
  "version": "0.1.0",
  "private": true,
  "description": "ServiceFlow Cloud Functions — the trusted backend (callables, webhooks, triggers, schedulers)",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@serviceflow/firebase": "workspace:*",
    "@serviceflow/shared": "workspace:*",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.2",
    "firebase": "12.17.1"
  }
}
