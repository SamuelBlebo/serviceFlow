# ServiceFlow web — Firebase client config.
# These values are PUBLIC identifiers (they ship in the browser bundle), not secrets.
# Stage 2 runs entirely on the local emulators with the demo project; the
# placeholder values below work as-is. Real values come from the Firebase
# console when a real project is created (after Decision D3).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-serviceflow.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-serviceflow
VITE_FIREBASE_STORAGE_BUCKET=demo-serviceflow.appspot.com
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Connect to the local Firebase Emulator Suite (pnpm emulators).
VITE_USE_EMULATORS=true
