# ServiceFlow mobile — public runtime flags (EXPO_PUBLIC_* values are bundled into the app; never put secrets here).
#
# React Native Firebase reads the Firebase project config from the native files
# referenced in app.config.ts (demo files by default), not from these variables.

# Connect to the local Firebase Emulator Suite (pnpm emulators).
EXPO_PUBLIC_USE_EMULATORS=true

# Host running the emulators. Defaults: 10.0.2.2 on the Android emulator, 127.0.0.1 on iOS simulator.
# For a physical phone on Wi-Fi, set your computer's LAN IP, e.g. 192.168.1.20.
EXPO_PUBLIC_EMULATOR_HOST=

EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west1
