{
  "name": "home-service",
  "private": true,
  "version": "0.1.0",
  "description": "Home Service — Ghana-first home-services marketplace (monorepo root)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm --filter=backend build",
    "dev": "pnpm --filter=backend dev",
    "test": "pnpm --filter=backend test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter=@home-service/database generate",
    "db:migrate": "pnpm --filter=@home-service/database migrate",
    "db:seed": "pnpm --filter=@home-service/database seed"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
